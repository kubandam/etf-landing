# Supabase (server only). Project Settings → API. Use the secret / service_role key, never expose it to the client.
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_KEY=

# PostHog, EU project. Empty key = no tracking (events only logged in the browser console).
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Resend (server only). Sender must be on a domain verified in Resend, e.g. "Porovnání ETF <porovnani@vasedomena.cz>".
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM=
# Where replies go (the e-mail says "reply to delete your address"). Must be an inbox someone reads.
NUXT_MAIL_REPLY_TO=
